diff --git a/system/vold/cryptfs.c b/system/vold/cryptfs.c
--- a/system/vold/cryptfs.c
+++ b/system/vold/cryptfs.c
@@ -3498,13 +3498,57 @@ error_shutting_down:
     return -1;
 }
 
+/*
+ * The retired Mirror's signed boot image marks /data forceencrypt, but the
+ * original encryption handoff no longer completes.  Keep its boot chain and
+ * mount the already-created ext4 userdata filesystem directly so Android can
+ * finish booting.  This path is reached only by init's first-boot command:
+ *     vdc --wait cryptfs enablecrypto inplace default noui
+ */
+static int mirror_revival_mount_unencrypted_data(void)
+{
+    char real_blkdev[MAXPATHLEN] = { 0 };
+
+    fs_mgr_get_crypt_info(fstab, 0, real_blkdev, sizeof(real_blkdev));
+    if (real_blkdev[0] == '\0') {
+        SLOGE("Mirror revival: userdata block device was not found\n");
+        return -1;
+    }
+
+    SLOGW("Mirror revival: mounting unencrypted userdata from %s\n",
+          real_blkdev);
+    if (fs_mgr_do_mount(fstab, DATA_MNT_POINT, real_blkdev, 0) != 0) {
+        SLOGE("Mirror revival: failed to mount userdata\n");
+        return -1;
+    }
+
+    property_set("ro.crypto.state", "unencrypted");
+    property_set("vold.decrypt", "trigger_load_persist_props");
+    if (prep_data_fs()) {
+        SLOGE("Mirror revival: post-fs-data failed\n");
+        return -1;
+    }
+
+    /* Reload the owner's key from the now-mounted /data filesystem. */
+    property_set("ctl.restart", "adbd");
+    property_set("vold.decrypt", "trigger_restart_framework");
+    SLOGW("Mirror revival: started Android with unencrypted userdata\n");
+    return 0;
+}
+
 int cryptfs_enable(char *howarg, int type, char *passwd, int no_ui)
 {
+    if (!strcmp(howarg, "inplace") && type == CRYPT_TYPE_DEFAULT && no_ui) {
+        return mirror_revival_mount_unencrypted_data();
+    }
     return cryptfs_enable_internal(howarg, type, passwd, no_ui);
 }
 
 int cryptfs_enable_default(char *howarg, int no_ui)
 {
+    if (!strcmp(howarg, "inplace") && no_ui) {
+        return mirror_revival_mount_unencrypted_data();
+    }
     return cryptfs_enable_internal(howarg, CRYPT_TYPE_DEFAULT,
                           DEFAULT_PASSWORD, no_ui);
 }
