diff --git a/frameworks/opt/net/wifi/service/java/com/android/server/wifi/WifiStateMachine.java b/frameworks/opt/net/wifi/service/java/com/android/server/wifi/WifiStateMachine.java
--- a/frameworks/opt/net/wifi/service/java/com/android/server/wifi/WifiStateMachine.java
+++ b/frameworks/opt/net/wifi/service/java/com/android/server/wifi/WifiStateMachine.java
@@ -385,5 +385,16 @@ public class WifiStateMachine extends StateMachine implements WifiNative.WifiRss
 
     private int mSupplicantRestartCount = 0;
 
+    /**
+     * The Mirror's WLAN device can appear several seconds after Android's
+     * framework first asks to enable Wi-Fi. Keep the controller in its
+     * enabling state while the device finishes probing instead of reporting a
+     * permanent failure after the first early attempt.
+     */
+    private static final int DRIVER_LOAD_RETRY_INTERVAL_MSECS = 5000;
+    private static final int DRIVER_LOAD_RETRY_TRIES = 12;
+
+    private int mDriverLoadRetryCount = 0;
+
     /* Tracks sequence number on stop failure message */
     private int mSupplicantStopFailureToken = 0;
@@ -5994,5 +6004,6 @@ public class WifiStateMachine extends StateMachine implements WifiNative.WifiRss
             switch (message.what) {
                 case CMD_START_SUPPLICANT:
                     if (mWifiNative.loadDriver()) {
+                        mDriverLoadRetryCount = 0;
                         try {
                             mNwService.wifiFirmwareReload(mInterfaceName, "STA");
@@ -6045,10 +6056,26 @@ public class WifiStateMachine extends StateMachine implements WifiNative.WifiRss
                             setWifiState(WifiManager.WIFI_STATE_FAILED);
                         }
                     } else {
-                        loge("Failed to load driver");
-                        setWifiState(WifiManager.WIFI_STATE_FAILED);
+                        if (++mDriverLoadRetryCount <= DRIVER_LOAD_RETRY_TRIES) {
+                            loge("Failed to load driver, retrying in "
+                                    + DRIVER_LOAD_RETRY_INTERVAL_MSECS + " ms ("
+                                    + mDriverLoadRetryCount + "/"
+                                    + DRIVER_LOAD_RETRY_TRIES + ")");
+                            setWifiState(WifiManager.WIFI_STATE_ENABLING);
+                            sendMessageDelayed(CMD_START_SUPPLICANT,
+                                    DRIVER_LOAD_RETRY_INTERVAL_MSECS);
+                        } else {
+                            loge("Failed to load driver after "
+                                    + DRIVER_LOAD_RETRY_TRIES + " retries");
+                            mDriverLoadRetryCount = 0;
+                            setWifiState(WifiManager.WIFI_STATE_FAILED);
+                        }
                     }
                     break;
                 case CMD_STOP_SUPPLICANT:
+                    // Cancel a pending delayed driver-load retry when Wi-Fi is
+                    // deliberately switched off.
+                    removeMessages(CMD_START_SUPPLICANT);
+                    mDriverLoadRetryCount = 0;
                     setWifiState(WifiManager.WIFI_STATE_DISABLED);
                     break;
diff --git a/device/qcom/msm8916_64/system.prop b/device/qcom/msm8916_64/system.prop
--- a/device/qcom/msm8916_64/system.prop
+++ b/device/qcom/msm8916_64/system.prop
@@ -129,3 +129,14 @@ persist.sys.usb.config=diag,serial_smd,rmnet_bam,adb
 
+# Owner-controlled MIRROR: keep RSA-authenticated ADB available over the LAN
+# so the display can be controlled without an internal USB connection.
+service.adb.tcp.port=5555
+
+# Qualcomm camera diagnostics for the recovered OV5640 sensor path. Defining
+# these in the product property file avoids the SELinux restriction that blocks
+# the generic post-boot shell from setting camera-owned persistent properties.
+persist.camera.hal.debug.mask=7
+persist.camera.mct.debug.mask=1
+persist.camera.sensor.debug=1
+
 #Set read only default composition for USB
 ro.sys.usb.default.config=diag,serial_smd,rmnet_bam,adb
